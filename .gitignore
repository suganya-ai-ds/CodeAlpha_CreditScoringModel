# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/
*.egg-info/
dist/
build/

# ── IDE and OS ────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── Secrets and environment variables ────────────────────────────────────────
.env
*.env
*.key
secrets.yaml
secrets.json

# ── pytest / coverage ─────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
*.coveragerc
.tox/

# ── Jupyter notebooks ─────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Model artifacts (large binary files — regenerate via py -m src.train) ────
# Comment out the line below if you want to commit the trained model.
# models/best_pipeline.joblib

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Temporary / generated (can be regenerated) ───────────────────────────────
# data/processed/ is generated by training — safe to exclude from commits
# but keep data/raw/ so others can verify the dataset
# data/processed/

# ── Windows specific ──────────────────────────────────────────────────────────
*.tmp
~$*

# ══════════════════════════════════════════════════════════════════════════════
# WHAT IS INTENTIONALLY COMMITTED:
# ══════════════════════════════════════════════════════════════════════════════
# ✅ src/            — all source modules
# ✅ tests/          — automated test suite
# ✅ app.py          — Streamlit dashboard
# ✅ requirements.txt
# ✅ README.md
# ✅ Start.md
# ✅ .gitignore
# ✅ data/raw/german_credit.csv (UCI public dataset, 36 KB)
# ✅ models/model_metadata.json
# ✅ outputs/reports/*.json, *.csv
# ✅ outputs/figures/*.png
#
# ❌ models/best_pipeline.joblib — large binary, regenerate via training
# ❌ data/processed/             — generated by training
# ❌ __pycache__/, .venv/, *.log

# Generated files - do not commit
models/best_pipeline.joblib
data/processed/
